# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Modelos por defecto de la plataforma (cada organización puede cambiar el suyo)
OPENROUTER_MODEL_ANALISIS=openai/gpt-4o-mini
OPENROUTER_MODEL_AGENTE=openai/gpt-4o-mini

# ── Sesiones y cifrado ────────────────────────────────────────────────────────
# Cadena aleatoria larga. Firma las cookies de sesión y deriva las claves de
# cifrado de la aplicación. Si cambia, se invalidan todas las sesiones abiertas.
# La vinculación de WhatsApp NO depende de esto: vive en <datos>/sesiones/.
SESSION_SECRET=

# ── Correo (SMTP) ─────────────────────────────────────────────────────────────
# El registro NO usa correo: se crea la cuenta y se entra en el acto. Esto hace
# falta solo para avisar al dueño de una solicitud de acceso de soporte. Sin
# ello nadie se queda fuera de su cuenta, pero esos avisos no llegan.
#
# Con Resend, los valores son literalmente estos: el usuario es la palabra
# "resend" (no tu correo) y la contraseña es la clave de API.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...
#
# SMTP_PASS tiene que ser la clave de API de verdad. Dejar el `re_...` de este
# ejemplo es el error más fácil de cometer: Resend responde
# "535 Authentication credentials invalid" y no sale ni un correo.
#
# Alternativa sin Resend — Gmail. Necesita verificación en dos pasos activada y
# una "contraseña de aplicación" (16 letras), NO la contraseña normal de la
# cuenta. Se genera en https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=tu@gmail.com
#   SMTP_PASS=las16letras
#   MAIL_FROM="SalesDash <tu@gmail.com>"
# Con Gmail, MAIL_FROM tiene que ser esa misma dirección. Sirve para arrancar y
# envía a cualquier destinatario, pero tiene un límite diario bajo: para un
# producto de verdad, un dominio propio en Resend.
#
# MAIL_FROM tiene que usar un dominio verificado en Resend. Mientras no lo
# tengas, "onboarding@resend.dev" funciona pero SOLO envía a la dirección de
# tu propia cuenta de Resend: sirve para probar, no para atender usuarios.
MAIL_FROM="SalesDash <no-reply@tudominio.com>"
#
# Comprueba que funciona sin pasar por la aplicación:
#   npm run probar-correo -- tu@correo.com

# ── Aplicación ────────────────────────────────────────────────────────────────
# Sin barra final. Se usa para armar la URL del webhook y los enlaces del correo.
# En EasyPanel es el dominio que te asigna el servicio, o el tuyo si lo montaste.
APP_URL=https://su-dominio.easypanel.host

# ── Meta (Messenger, DM de Instagram y comentarios de anuncios) ────────────────
# Todo esto sale de https://developers.facebook.com/apps → tu app.
#
# El identificador de la app. No es secreto: aparece en la propia URL del panel.
META_APP_ID=

# EL SECRETO DE LA APP. Dos usos, y el segundo es el que importa:
#   1. Autenticar llamadas a la Graph API.
#   2. Firmar. Meta manda cada webhook con una cabecera X-Hub-Signature-256 que
#      es un HMAC-SHA256 del cuerpo con esta clave. Sin comprobarla, cualquiera
#      que sepa tu URL puede inventarse mensajes, ventas y clientes.
#
# El error clásico al comprobarla no es la clave: es el cuerpo. El HMAC tiene
# que calcularse sobre el cuerpo CRUDO tal como llegó. Si lo pasas por
# `JSON.parse` y lo vuelves a serializar, cambian espacios y orden de claves, y
# la firma no cuadra nunca aunque el secreto sea correcto.
META_APP_SECRET=

# Una cadena larga que te inventas tú: no te la da Meta. Se escribe DOS veces,
# aquí y en el panel de Meta al dar de alta el webhook, y tienen que ser
# idénticas. Meta la manda de vuelta una sola vez, en el GET de verificación
# (`hub.verify_token`), y solo sirve para eso: probar que la URL es tuya. No
# firma nada — eso es META_APP_SECRET.
META_VERIFY_TOKEN=

# Versión de la Graph API, fijada a propósito. Sin fijarla, Meta te mueve el
# contrato de debajo cuando saca una versión nueva y las llamadas empiezan a
# fallar sin que hayas tocado una línea. Cambiarla es una decisión, no un
# descuido: cada versión tiene su fecha de caducidad.
META_GRAPH_VERSION=v23.0

# `false` mientras la app está en modo Desarrollo, `true` cuando pasa a Live.
#
# Esto NO enciende ni apaga nada de nuestro lado: describe en qué modo está la
# app en el panel de Meta, y el modo cambia a quién le llegan los eventos. En
# Desarrollo, el webhook SOLO dispara para las cuentas que tienen un rol en la
# app (administrador, desarrollador, tester). Es la explicación de casi todo
# «configuré todo y no me llega nada»: la app sigue en Desarrollo y quien
# escribió no es del equipo.
META_APP_LIVE=false
