# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Modelos por defecto de la plataforma (cada organización puede cambiar el suyo)
OPENROUTER_MODEL_ANALISIS=openai/gpt-4o-mini
OPENROUTER_MODEL_AGENTE=openai/gpt-4o-mini

# ── Sesiones y cifrado ────────────────────────────────────────────────────────
# Cadena aleatoria larga. Firma las cookies y deriva la clave AES-256-GCM
# con la que se cifran los tokens de Whapi. Si cambia, se invalidan las
# sesiones Y dejan de poder descifrarse los tokens guardados.
SESSION_SECRET=

# ── Whapi ─────────────────────────────────────────────────────────────────────
# Token de la cuenta Partner (credencial de la plataforma, no del usuario).
# Sirve para crear/eliminar canales desde el panel.
WHAPI_PARTNER_TOKEN=
# Proyecto donde se agrupan los canales. Si se deja vacío, se toma el primero
# que devuelva GET https://manager.whapi.cloud/projects
WHAPI_PARTNER_PROJECT_ID=

# ── Correo (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SalesDash <no-reply@tudominio.com>"

# ── Aplicación ────────────────────────────────────────────────────────────────
# Sin barra final. Se usa para armar la URL del webhook y los enlaces del correo.
APP_URL=https://tudominio.com
