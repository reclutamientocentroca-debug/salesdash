{
  "name": "salesdash",
  "version": "0.1.0",
  "private": true,
  "description": "SalesDash — plataforma multiusuario para medir ventas por WhatsApp",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test tests/aislamiento.test.ts tests/conteo.test.ts tests/cierres.test.ts tests/agente.test.ts"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "better-sqlite3": "^12.2.0",
    "argon2": "^0.44.0",
    "jose": "^6.0.11",
    "nodemailer": "^7.0.3",
    "openai": "^7.5.0",
    "zod": "^4.0.5",
    "tailwindcss": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "postcss": "^8.5.6",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^7.0.0"
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true
  }
}
