{
  "name": "salesdash",
  "version": "0.1.0",
  "private": true,
  "description": "SalesDash — plataforma multiusuario para medir ventas por WhatsApp",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test": "node --import tsx --test tests/aislamiento.test.ts tests/conteo.test.ts tests/cierres.test.ts tests/supervisor.test.ts tests/revisor.test.ts tests/agente.test.ts tests/limites.test.ts tests/ubicacion.test.ts tests/canales-ia.test.ts tests/enlace.test.ts tests/meta.test.ts",
    "probar-correo": "tsx scripts/probar-correo.ts",
    "superadmin": "tsx scripts/hacer-superadmin.ts",
    "verificar-ia": "tsx tests/real-ia.ts",
    "verificar-vision": "tsx tests/real-vision.ts",
    "diagnostico": "tsx scripts/diagnostico.ts",
    "conteo": "tsx scripts/conteo.ts",
    "verificar-audio": "tsx tests/real-audio.ts",
    "probar-agente": "tsx tests/real-agente.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "argon2": "^0.44.0",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^12.2.0",
    "jose": "^6.0.11",
    "next": "^16.0.0",
    "nodemailer": "^7.0.3",
    "openai": "^7.5.0",
    "postcss": "^8.5.6",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "argon2": true,
    "better-sqlite3": true,
    "esbuild": true,
    "baileys": true,
    "protobufjs": true
  }
}
